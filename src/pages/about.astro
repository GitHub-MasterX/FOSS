---
// src/pages/about.astro
import Navbar from '../components/navbar.astro';
import '../components/about.css';

const communityName = "FOSS.TRICHY";
const currentYear = new Date().getFullYear();
const whatsappUrl = "https://chat.whatsapp.com/GtuJVlEUKXhKn3I67b8D1e";

// Core Team Configuration:
// Set your photo in /public/team/ or use /default-avatar.svg for the default profile avatar.
const teamMembers = [
  {
    name: "Lead Organizer",
    role: "Community & Club Lead",
    image: "/default-avatar.svg", // Default profile avatar
    bio: "Fostering open-source software culture, student participation, and community events at SRM Trichy.",
    github: "https://github.com/",
    linkedin: "https://linkedin.com/",
  },
  {
    name: "Technical Lead",
    role: "Open Source & Systems",
    image: "/default-avatar.svg",
    bio: "Guiding members in Git workflows, fullstack architectures, Linux systems, and upstream contributions.",
    github: "https://github.com/",
    linkedin: "https://linkedin.com/",
  },
  {
    name: "Operations Lead",
    role: "Logistics & Outreach",
    image: "/default-avatar.svg",
    bio: "Coordinating hackathons, speaker sessions, registrations, and campus outreach across departments.",
    github: "https://github.com/",
    linkedin: "https://linkedin.com/",
  },
  {
    name: "Design & Media Lead",
    role: "Brand & Creative Direction",
    image: "/default-avatar.svg",
    bio: "Crafting visual identities, banners, motion elements, and digital experiences for FOSS initiatives.",
    github: "https://github.com/",
    linkedin: "https://linkedin.com/",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us | {communityName}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navbar /> 

    <!-- Ambient Glow Lighting -->
    <div class="glow-wrapper" aria-hidden="true">
      <div class="glow-orb-1"></div>
      <div class="glow-orb-2"></div>
    </div>

    <main class="about-page">
      <!-- Hero Section -->
      <section class="about-hero">
        <div class="badge-pill">
          <span>About FOSS SRM Trichy</span>
        </div>

        <h1 class="page-title">
          Built by Students, <br />
          <span class="text-gradient">Driven by Open Source.</span>
        </h1>

        <p class="lead-text">
          The FOSS Club at SRM Institute of Science & Technology, Tiruchirappalli is an active student collective 
          dedicated to fostering open-source software culture, peer mentorship, and real-world engineering practices.
        </p>
      </section>

      <!-- Section: Who We Are & What We Stand For -->
      <section class="content-section">
        <div class="section-title-wrap">
          <h2 class="section-title">Who We Are</h2>
        </div>

        <div class="grid-2">
          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </div>
              <h3>Bridging the Gap</h3>
            </div>
            <p>
              Academic coursework teaches foundational algorithms and theory; FOSS bridges that directly with real-world 
              tools. We dive deep into Git workflows, open-source licensing, CI/CD automation, pull request etiquette, 
              and production code reviews.
            </p>
          </div>

          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <h3>Collaborative Culture</h3>
            </div>
            <p>
              We believe great engineering happens through peer exchange and shared curiosity. From first-year students 
              submitting their first pull requests to senior mentors architecting cloud systems, everyone has a place to 
              learn and teach.
            </p>
          </div>
        </div>
      </section>

      <!-- Section: Pillars of Impact -->
      <section class="content-section">
        <div class="section-title-wrap">
          <h2 class="section-title">What We Do</h2>
        </div>

        <div class="grid-3">
          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <h3>Hands-on Workshops</h3>
            </div>
            <p>Practical weekend bootcamps focusing on Git, Linux environments, web technologies, and backend microservices.</p>
          </div>

          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
              </div>
              <h3>Hackathons & Sprints</h3>
            </div>
            <p>High-energy coding marathons where students build tangible open-source solutions to address community challenges.</p>
          </div>

          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <h3>Upstream Contributions</h3>
            </div>
            <p>Guiding students to contribute code, fix issues, and draft documentation in popular global open-source projects.</p>
          </div>
        </div>
      </section>

      <!-- Section: Past Initiatives (GenTech, Digital Security with SFLC, Yuva Hackathon) -->
      <section class="content-section">
        <div class="section-title-wrap">
          <h2 class="section-title">Past Initiatives & Milestones</h2>
        </div>

        <div class="grid-3">
          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <h3>GenTech</h3>
            </div>
            <p>
              A focused workshop on open-source tools and computational bioinformatics environments used to analyze and process complex genetic data.
            </p>
          </div>

          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </div>
              <h3>Digital Security</h3>
            </div>
            <p>
              Conducted by experts from SFLC.in (Software Freedom Law Center), teaching open-source digital security hygiene, privacy, and user rights.
            </p>
          </div>

          <div class="info-card">
            <div class="info-card-header">
              <div class="card-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </div>
              <h3>Yuva Hackathon</h3>
            </div>
            <p>
              A premier 24-hour non-stop hackathon conducted last year at SRM Trichy, uniting student developers to brainstorm, code, and ship working prototypes.
            </p>
          </div>
        </div>

        <!-- Callout Banner to Past Events -->
        <div class="callout-card">
          <div class="callout-content">
            <h4>Want to see pictures from these events?</h4>
            <p>Browse through photos from our 24-hour hackathon, workshops, and campus sessions in our event gallery.</p>
          </div>
          <a href="/event#past-events" class="callout-btn">
            <span>View Past Events</span>
            <span>→</span>
          </a>
        </div>
      </section>

      <!-- Section: The Team / Us -->
      <section id="team" class="content-section team-section">
        <div class="section-title-wrap">
          <div class="badge-pill team-badge-pill">
            <span>Us • The Core Crew</span>
          </div>
          <h2 class="section-title">The Team Behind FOSS SRM Trichy</h2>
          <p class="section-subtext">
            Meet the student builders, designers, and organizers dedicated to cultivating open-source culture at SRM Trichy.
          </p>
        </div>

        <div class="team-grid">
          {teamMembers.map((member) => (
            <div class="team-card">
              <div class="team-avatar-wrap">
                <img 
                  src={member.image || "/default-avatar.svg"} 
                  alt={`${member.name} - ${member.role}`} 
                  class="team-avatar-img" 
                  loading="lazy" 
                />
              </div>
              <div class="team-content">
                <span class="team-role-badge">{member.role}</span>
                <h3 class="team-name">{member.name}</h3>
                <p class="team-bio">{member.bio}</p>
                <div class="team-social-links">
                  {member.github && (
                    <a href={member.github} target="_blank" rel="noopener noreferrer" class="team-social-link" title="GitHub" aria-label="GitHub Profile">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    </a>
                  )}
                  {member.linkedin && (
                    <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="team-social-link" title="LinkedIn" aria-label="LinkedIn Profile">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}

          <!-- Open Contributor Spot Card -->
          <div class="team-card join-team-card">
            <div class="team-avatar-wrap">
              <div class="team-avatar-placeholder contributor-avatar">
                <span class="avatar-plus-icon">+</span>
              </div>
            </div>
            <div class="team-content">
              <span class="team-role-badge contributor-badge">Open Source Volunteer</span>
              <h3 class="team-name">You?</h3>
              <p class="team-bio">Passionate about code, design, or community? FOSS SRM Trichy is open for every student to contribute and lead.</p>
              <a href="https://chat.whatsapp.com/GtuJVlEUKXhKn3I67b8D1e" target="_blank" rel="noopener noreferrer" class="join-team-btn">
                <span>Join Community</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>


      <!-- Join Community Banner (WhatsApp Only) -->
      <section class="join-banner">
        <h2>Join The Community on WhatsApp</h2>
        <p>
          Connect directly with fellow students, event organizers, and open-source contributors in our official WhatsApp group:
        </p>

        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="social-card-btn whatsapp-cta" style="background: rgba(37, 211, 102, 0.1); border-color: rgba(37, 211, 102, 0.35); color: #a7f3d0;">
          <img src="/whatsapp.svg" alt="WhatsApp" width="24" height="24" />
          <span>Join WhatsApp Community</span>
          <span>→</span>
        </a>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <p>&copy; {currentYear} {communityName} • Built with Astro OSS.</p>
      <p style="font-size: 0.8rem; color: #6b7280; margin-top: 0.35rem;">SRM Institute of Science & Technology, Tiruchirappalli</p>
    </footer>
  </body>
</html>