---
// src/pages/register.astro
return Astro.redirect("https://tsrm.in/foss", 301);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=https://tsrm.in/foss" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to Registration | FOSS SRM Trichy</title>
    <link rel="canonical" href="https://tsrm.in/foss" />
  </head>
  <body style="background: #060608; color: #e5e7eb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; padding: 1.5rem; text-align: center;">
    <div style="max-width: 480px; background: rgba(14, 15, 22, 0.9); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 2.5rem 2rem; box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);">
      <h2 style="color: #ffffff; margin-top: 0; margin-bottom: 0.75rem; font-size: 1.5rem;">Redirecting to Registration Portal...</h2>
      <p style="color: #9ca3af; margin-bottom: 1.75rem; font-size: 0.95rem; line-height: 1.5;">
        Official club registrations and event sign-ups are hosted on the SRM Trichy portal at <strong>tsrm.in/foss</strong>.
      </p>
      <a href="https://tsrm.in/foss" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 0.95rem; box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);">
        <span>Continue to tsrm.in/foss</span>
        <span>→</span>
      </a>
    </div>
    <script>
      window.location.replace("https://tsrm.in/foss");
    </script>
  </body>
</html>
