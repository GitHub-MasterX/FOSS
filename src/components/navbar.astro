---
// src/components/navbar.astro
const pathname = Astro.url.pathname;
---

<header class="navbar">
  <div class="nav-container">
    <a href="/" class="logo" aria-label="FOSS SRM Trichy Home">
      <img src="/logos/Light_Transparent.png" alt="FOSS Logo" class="logo-img" />
      <div class="logo-text">
        <span class="logo-accent">FOSS</span><span class="logo-sep">.</span><span class="logo-sub">TRICHY</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-links" id="navLinks">
      <a href="/" class={pathname === "/" ? "active" : ""}>
        <span>Home</span>
      </a>
      <a href="/about" class={pathname === "/about" || pathname === "/about/" ? "active" : ""}>
        <span>About</span>
      </a>
      <a href="/event" class={pathname === "/event" || pathname === "/event/" ? "active" : ""}>
        <span>Events</span>
      </a>
      <a href="https://tsrm.in" target="_blank" rel="noopener noreferrer" class="nav-btn-register">
        <span>Register</span>
        <span class="external-icon" aria-hidden="true">↗</span>
        <span class="btn-glow"></span>
      </a>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button class="menu-toggle" id="menuToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-nav-links">
      <a href="/" class={pathname === "/" ? "active" : ""}>
        <span>Home</span>
      </a>
      <a href="/about" class={pathname === "/about" || pathname === "/about/" ? "active" : ""}>
        <span>About</span>
      </a>
      <a href="/event" class={pathname === "/event" || pathname === "/event/" ? "active" : ""}>
        <span>Events</span>
      </a>
      <a href="https://tsrm.in" target="_blank" rel="noopener noreferrer" class="mobile-btn-register">
        <span>Register on tsrm.in ↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu interactive toggle
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const navbar = document.querySelector('.navbar');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      menuToggle.classList.toggle('is-open');
      mobileMenu.classList.toggle('is-open');
    });

    // Close on clicking links
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.classList.remove('is-open');
        mobileMenu.classList.remove('is-open');
      });
    });
  }

  // Add slight shadow and backdrop blur on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  }, { passive: true });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: rgba(6, 6, 8, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 9999;
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .navbar.scrolled {
    background: rgba(6, 6, 8, 0.92);
    border-bottom-color: rgba(99, 102, 241, 0.2);
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.5);
  }

  .nav-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .logo:hover {
    transform: scale(1.02);
  }

  .logo-img {
    height: 2.2rem;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.4));
  }

  .logo-text {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    display: flex;
    align-items: center;
  }

  .logo-accent {
    background: linear-gradient(135deg, #a5b4fc, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
  }

  .logo-sep {
    color: #6366f1;
    margin: 0 1px;
  }

  .logo-sub {
    color: #e5e7eb;
    font-weight: 600;
  }

  /* Desktop Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    position: relative;
    color: #9ca3af;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.4rem 0.2rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #ffffff;
  }

  .nav-links a:not(.nav-btn-register)::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #6366f1, #06b6d4);
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 2px;
  }

  .nav-links a:hover::after,
  .nav-links a.active::after {
    width: 100%;
  }

  /* Register CTA Button */
  .nav-btn-register {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff !important;
    padding: 0.55rem 1.35rem !important;
    border-radius: 8px;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    border: 1px solid rgba(165, 180, 252, 0.3);
    box-shadow: 0 0 16px -2px rgba(99, 102, 241, 0.4);
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .external-icon {
    font-size: 0.85rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .nav-btn-register:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 24px 0 rgba(99, 102, 241, 0.6);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .nav-btn-register:hover .external-icon {
    transform: translate(2px, -2px);
  }

  /* Hamburger Toggle */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    cursor: pointer;
    padding: 8px;
    gap: 5px;
    transition: all 0.2s ease;
  }

  .menu-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .bar {
    display: block;
    width: 20px;
    height: 2px;
    background-color: #e5e7eb;
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle.is-open .bar-1 {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle.is-open .bar-2 {
    opacity: 0;
  }

  .menu-toggle.is-open .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Dropdown Menu */
  .mobile-menu {
    display: none;
    max-height: 0;
    overflow: hidden;
    background: rgba(10, 10, 14, 0.98);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), padding 0.35s ease;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .mobile-menu.is-open {
    max-height: 320px;
    padding: 1rem 1.5rem 1.5rem 1.5rem;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.6);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mobile-nav-links a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .mobile-nav-links a:hover,
  .mobile-nav-links a.active {
    color: #ffffff;
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .mobile-nav-links .link-icon {
    font-size: 1.2rem;
  }

  .mobile-btn-register {
    justify-content: center !important;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%) !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    border: 1px solid rgba(165, 180, 252, 0.4) !important;
    margin-top: 0.4rem;
    box-shadow: 0 4px 16px rgba(99, 102, 241, 0.35);
  }

  /* Responsive Rules */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }

    .nav-container {
      padding: 0.75rem 1.2rem;
    }
  }
</style>